<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pleos Connect(Android Automotive OS)용 앱 -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- 읽기 전용 공개 권한만 선언해요. 승인되지 않은 권한을 선언하면 심사에서 떨어질 수 있어요. -->
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />
    <uses-permission android:name="pleos.car.permission.CAR_TIRES" />
    <uses-permission android:name="pleos.car.permission.CAR_MILEAGE" />
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />
    <uses-permission android:name="pleos.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="pleos.car.permission.READ_WINDSHIELD_WIPERS" />

    <!-- 음성 안내: Pleos TTS SDK가 차량 음성 엔진(CaaS)을 쓰려면 꼭 필요해요(normal 권한, 설치 시 자동 허용).
         제출 전에 공모전 승인 권한 목록에 있는지 확인하세요. TTS SDK는 INTERNET 권한도 함께 넣어요. -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />

    <!-- 음성 안내용 TTS 엔진을 찾기 위한 선언(권한 아님). Android 11 이상에서는 없으면 엔진이 안 보여요. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CarHealth">

        <!-- 주행 상태(CarUxRestrictions)를 읽기 위한 차량 라이브러리. 없는 기기에서도 설치되도록 required=false -->
        <uses-library
            android:name="android.car"
            android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|keyboard|keyboardHidden|navigation">
            <!-- 주행 중에도 요약 카드를 보여 주기 위해 주행 중 최적화(DO) 앱으로 선언해요.
                 앱은 CarUxRestrictions를 받아 주행 중에는 3D와 상세 정보를 숨겨요. -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
